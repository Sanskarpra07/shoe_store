# 1. CRISIS PREVENTION: Never upload your database password!
wp-config.php

# 2. FILE SIZE CONTROL: Never upload your photos, videos, or PDFs
wp-content/uploads/

# 3. SPEED: Don't upload core WordPress files (GitHub doesn't need them)
wp-admin/
wp-includes/
*.php
!.gitignore

# 4. EXCEPTION: Only keep your specific custom theme or plugin
# (Replace 'your-custom-theme' with your actual folder name)
!wp-content/
wp-content/*
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/your-custom-theme/
!database/
